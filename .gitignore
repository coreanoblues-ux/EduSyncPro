node_modules
# dist는 통째로 무시한다. 예전에 dist/index.js만 예외로 두고 커밋했더니,
# Nixpacks가 빌드 뒤에 실행하는 COPY . /app 이 갓 빌드한 번들을 저장소의
# 낡은 파일로 덮어써서 운영 서버만 몇 커밋 뒤처진 채로 돌았다.
# (화면은 dist/public이 무시 대상이라 매번 새로 빌드되어 최신처럼 보였다.)
dist/
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# Toss Front 플러그인 ZIP.
#
# 작업 중 생긴 ZIP 은 저장소에 넣지 않는다. 손에 굴러다니는 압축본이 여러 개면
# 개발자센터에 엉뚱한 걸 올리게 되고, 그게 바로 0.2.0 검은 화면 사고였다.
#
# 예외는 releases/ 하나. 여기엔 "개발자센터에 실제로 업로드한 것"만 넣는다.
# 파일명에 버전이 박혀 있어(edusyncpro-front-0.3.0.zip) 소스와 조용히 어긋날 수 없고,
# 집·학원 어느 컴퓨터에서든 다시 빌드하지 않고 꺼내 쓸 수 있다.
plugins/**/*.zip
!plugins/toss-front/releases/
!plugins/toss-front/releases/*.zip

# DB 덤프 — 학생 개인정보와 결제 기록이 통째로 들어 있다. 절대 커밋 금지.
*.dump
*.sql.gz

# 환경변수 (절대 커밋 금지)
.env
.env.local
.env.*.local

# 쿠키/세션 파일
cookies.txt
cookies_secure.txt
cookies_test.txt

# Replit 잔재. 이 앱은 Railway에서 도는 평범한 Node 서버라 Replit이 없어도 되지만,
# Replit 에디터로 한 번이라도 열면 이 파일들이 되살아난다. 저장소에는 못 들어오게 막는다.
# (.local은 Replit 에이전트 상태 27MB/188개짜리인데 예전에 통째로 커밋돼 있었다.)
.replit
replit.nix
.local/
.upm/
.cache/

# 로그
*.log
npm-debug.log*

# 빌드 캐시
.vite/
