# =====================================================
# EduSyncPro — 환경변수 목록 (이 파일을 .env로 복사해서 값을 채우세요)
# =====================================================
# 로컬 실행:  cp .env.example .env  → 값 채우기 → npm run dev
# Railway:    대시보드 → Variables → RAW Editor에 붙여넣기
# 주의: 값을 채운 .env는 절대 커밋하지 말 것 (.gitignore에 등록돼 있음)
#
# 이 앱은 이 다섯 개 변수만 있으면 어디서든 돈다. Replit이 자동으로
# 넣어주던 변수에 기대는 곳은 한 군데도 없다.
# =====================================================

# [필수] PostgreSQL 연결 문자열
# ⚠️ Replit이 만들어준 DB가 아니라, 본인 계정으로 직접 만든 DB여야 한다.
#    Replit이 붙여준 Neon 프로젝트는 구독이 끊기면 같이 잠긴다.
#    Neon:    console.neon.tech → 본인 계정 프로젝트 → Connection string
#    Railway: 대시보드 → Postgres 서비스 → Variables → DATABASE_URL
#    로컬:    postgresql://postgres:비밀번호@localhost:5432/edusync
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# [필수] JWT 서명 키 (32자 이상 랜덤 문자열 권장)
# 생성법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 비워두면 서버가 부팅할 때마다 임시 키를 새로 만든다. 죽지는 않지만
# 재배포·재시작 때마다 전원 로그아웃되므로 반드시 채워둘 것.
JWT_SECRET=여기에_32자_이상의_랜덤_시크릿_키_입력

# [필수] 시스템 관리자(superadmin) 로그인 비밀번호
# 이 값이 없으면 admin 로그인이 비활성화됩니다 (앱은 정상 작동)
# 생성법: 12자 이상의 복잡한 비밀번호 권장
ADMIN_PASSWORD=여기에_관리자_비밀번호_입력

# [선택] 자연어 빠른 입력 기능용 OpenAI API 키
# platform.openai.com → API keys 에서 발급
# 이 값이 없으면 빠른 입력만 비활성화되고 나머지 기능은 정상 작동합니다.
# ⚠️ 이 키는 채팅·메신저·코드에 절대 붙여넣지 말고 Railway Variables에만 등록하세요.
OPENAI_API_KEY=sk-여기에_발급받은_키_입력

# [선택] 사용할 모델 (기본값: gpt-4o-mini)
# gpt-4o-mini는 저렴하고 이 용도에 충분합니다.
OPENAI_MODEL=gpt-4o-mini

# [필수] 실행 환경 (로컬 개발은 development, 배포는 production)
NODE_ENV=production

# [선택] 수신 포트 (기본값 3000)
# Railway·Docker는 알아서 주입하므로 보통 비워둔다. 로컬에서 포트가
# 겹칠 때만 바꾸면 된다.
PORT=3000
